"<!doctype html><html lang=\"fr\" dir=\"ltr\"><head><meta charset=\"utf-8\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; style-src 'unsafe-inline'; font-src data:; img-src data:\"><title>SIM-001 · TEST</title><style>\n@page{size:A4;margin:0}*{box-sizing:border-box}body{margin:0;font-family:Arial,'DejaVu Sans',sans-serif;color:#0e1318;font-size:9pt;line-height:1.24}html[dir=rtl] body{font-family:Contract,'DejaVu Sans',sans-serif}.page{min-height:297mm;padding:11mm 11mm 14mm;position:relative;break-after:page}.page:last-child{break-after:auto}.head{display:flex;align-items:center;gap:12px;border-bottom:1px solid #dce3ed;padding-bottom:10px;margin-bottom:10px}.logo{background:#071c47;color:white;border-radius:9px;width:38px;height:38px;flex-shrink:0;text-align:center;font-weight:bold;font-size:25px;line-height:38px;direction:ltr}.brand{font-size:12px;font-weight:bold;overflow-wrap:anywhere}.phone{display:block;font-size:9px;font-weight:normal;margin-top:3px}.badge{margin-inline-start:auto;background:#fff2d9;padding:8px;border-radius:5px;font-weight:bold;font-size:9px;white-space:nowrap}.warning{background:#fff2d9;padding:7px;margin:7px 0;font-size:9px}.legal{font-size:9px}.number,.ref{direction:ltr;unicode-bidi:isolate;display:inline-block}h1{font-size:18px;margin:7px 0 8px}h2{font-size:11px;background:#edf3ff;padding:5px;margin:8px 0 4px}h3{font-size:9pt;margin:0 0 3px}p{margin:0 0 7px}.rows{display:grid;grid-template-columns:1fr 1fr;gap:3px 13px}.cell{border-bottom:1px solid #dce3ed;padding:4px 0;min-height:31px;overflow-wrap:anywhere}.label{font-size:8.5px;color:#59677e;display:block;margin-bottom:3px}.wide{grid-column:1/-1}.small{font-size:8.5px}.signs{display:flex;gap:12px;margin-top:9px;break-inside:avoid}.sign{border:1px solid #dce3ed;border-radius:5px;padding:7px;width:50%;min-height:48px;font-size:10px}.footer{position:absolute;bottom:7mm;left:11mm;right:11mm;border-top:1px solid #dce3ed;padding-top:4px;color:#59677e;font-size:7px;display:flex;justify-content:space-between}.columns{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:10px;font-size:9pt;line-height:1.23}.columns>div+div{border-inline-start:1px solid #dce3ed;padding-inline-start:12px}article{margin-bottom:8px;break-inside:avoid}.signature-label{font-size:8px;color:#59677e;margin-top:4px}.note{white-space:pre-wrap;overflow-wrap:anywhere}html[dir=rtl] .columns{line-height:1.5;font-size:9pt}html[dir=rtl] h3{font-size:9pt}.conditions{padding-bottom:12mm}.conditions .footer{position:static;margin-top:8px}.conditions .signs{margin-top:10px}\n.front.swap-contract .reference-head{margin-bottom:8px;padding-bottom:8px}.front.swap-contract .ref-card-body{padding:9px}.front.swap-contract .drivers{margin-bottom:8px}.front.swap-contract .ref-card-title{padding:8px 10px}\n\n.logo{background:transparent!important;border-radius:0;width:140px;height:42px;line-height:normal}.contract-brand-logo{display:block;width:140px;height:42px;object-fit:contain}\n</style>\n<style>\n.reference-head{display:grid;grid-template-columns:1.05fr 1.65fr 140px;gap:13px;align-items:start;border-bottom:2px solid #004fff;padding-bottom:12px;margin-bottom:13px;direction:ltr}.contract-name{font-size:18px;line-height:1.15;color:#003dcc;font-weight:800;margin-bottom:7px}.reference-no{display:inline-block;background:#edf3ff;color:#003dcc;border-radius:5px;padding:7px;font-size:10px;font-weight:bold}.reference-company{text-align:right;font-size:8.5px;line-height:1.45}.reference-company strong{display:block;font-size:12px;color:#1c2b41}.logo{background:#071c47}.draft-strip{font-size:8.5px;background:#fff3dc;border:1px solid #ead19c;border-radius:4px;padding:6px 8px;margin-bottom:10px}.drivers{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:11px}.ref-card{border:1px solid #d9e2ee;border-radius:9px;overflow:hidden;break-inside:avoid}.ref-card-title{padding:9px 11px;background:#f0f4f9;color:#46576c;font-size:10px;font-weight:bold;display:flex;align-items:center;gap:7px}.ref-card-title svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:1.8;flex-shrink:0}.ref-card-body{padding:9px 11px}.ref-driver-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px 13px}.ref-label{color:#637186;font-size:8px;display:block;margin-bottom:5px}.ref-value{font-size:10px;font-weight:bold;overflow-wrap:anywhere;line-height:1.35}.ref-vehicle{margin-bottom:11px}.ref-vehicle .ref-card-title{background:#eef8ff;color:#086b96}.ref-vehicle-grid{display:grid;grid-template-columns:2fr 1.25fr .8fr 1fr;gap:10px;align-items:start}.plate-tag{display:inline-block;background:#24354b;color:white;padding:4px 6px;border-radius:4px;font-size:11px}.ref-table{width:100%;border-collapse:collapse;margin:0 0 10px;font-size:9px;table-layout:fixed}.ref-table th{background:#004fff;color:#fff;text-align:start;padding:9px 8px;font-weight:bold;font-size:8px}.ref-table td{border:1px solid #dbe4f0;padding:10px 8px;vertical-align:middle;overflow-wrap:anywhere}.ref-table td.center{text-align:center}.ref-table .pay{padding:7px 8px;background:#f6f9fd}.ref-money{font-size:12px;font-weight:bold;color:#003dcc}.ref-summary{display:grid;grid-template-columns:1fr 1fr;gap:12px;background:#edf3ff;border:1px solid #dce3ed;border-radius:5px;padding:8px 10px;margin-bottom:9px;font-size:9px}.ref-summary .ref-label{font-size:8px}.ref-state{font-size:9px;border:1px solid #d9e2ee;border-radius:5px;padding:8px 10px;margin-bottom:9px;overflow-wrap:anywhere}.ref-state strong{font-size:9px}.ref-notes{white-space:pre-wrap;overflow-wrap:anywhere;margin-top:5px}.ref-small{font-size:8px;line-height:1.35;margin:0 0 6px}.ref-signatures{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:10px 0}.ref-sign{height:64px;border:1px dashed #b7c9e1;border-radius:7px;padding:9px;color:#546980;font-size:8px;font-weight:bold;break-inside:avoid}.ref-sign.client{border:1px solid #4e84da;background:#f4faff}.ref-legal{font-size:8px;line-height:1.45;background:#fff7ed;border:1px so